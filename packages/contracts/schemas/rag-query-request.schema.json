{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-foundry/contracts/schemas/rag-query-request.schema.json",
  "title": "RagQueryRequest",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://rag-foundry/contracts/schemas/dense-search-request.fragment.schema.json"
    }
  ],
  "required": ["question"],
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "pattern": "^.*\\S.*$"
    },
    "context_k": { "type": "integer", "minimum": 1, "maximum": 50 },
    "model_id": { "type": "string", "minLength": 1 },
    "guardrails_id": { "type": "string", "minLength": 1 },
    "guardrails_version": { "type": "string", "minLength": 1 },
    "guardrailIdentifier": { "type": "string", "minLength": 1 },
    "guardrailVersion": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
